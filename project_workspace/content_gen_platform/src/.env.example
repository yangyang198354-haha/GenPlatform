# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_SETTINGS_MODULE=config.settings.production

# ── Encryption (32-byte AES key, base64-encoded) ──────────────────────────
ENCRYPTION_KEY=change-me-to-a-base64-encoded-32-byte-key=

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=content_gen_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://postgres:change-me-strong-password@db:5432/content_gen_platform

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS / Hosts ───────────────────────────────────────────────────────────
ALLOWED_HOSTS=localhost,your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ── 豆包 Ark 图片生成（NFR-3，ADR-06）─────────────────────────────────────
# ARK_API_KEY 不可硬编码！必须通过平台设置界面录入，存储在 settings_vault（AES-256-GCM 加密）
# 此处仅作环境变量名占位，实际 Key 值不写入本文件
ARK_API_KEY=                              # 占位，勿在此填写真实 Key，通过设置页面配置
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 批次生成模式：single_request（单次 Ark 请求返回 n 张）| multi_request（串行多次）
DOUBAO_BATCH_MODE=single_request

# ── Storage ────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
# For MinIO:
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=content-gen
