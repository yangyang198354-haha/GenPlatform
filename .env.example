# .env.example — GenPlatform 环境变量模板
# 使用方式: cp .env.example .env，然后填写真实配置
#
# 物理机部署与 Docker 部署的差异项已在注释中标注:
#   [物理机] = 物理机部署时的推荐值
#   [Docker]  = Docker 部署时的推荐值
# ═══════════════════════════════════════════════════════════════════════════════

# ── Django 核心配置 ────────────────────────────────────────────────────────────

# Django 密钥（必填，生产环境必须替换为随机字符串，长度 >= 50）
# 生成命令: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string

# Django 配置模块（通常无需修改）
DJANGO_SETTINGS_MODULE=config.settings.production

# 调试模式（生产环境必须为 False）
DEBUG=False

# ── 加密密钥 ───────────────────────────────────────────────────────────────────

# 32字节 AES 密钥（base64 编码，必填）
# 生成命令: python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=change-me-to-a-base64-encoded-32-byte-key=

# ── 数据库配置 ─────────────────────────────────────────────────────────────────

POSTGRES_DB=content_gen_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# DATABASE_URL 连接字符串:
#   [物理机] DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/content_gen_platform
#   [Docker]  DATABASE_URL=postgresql://postgres:PASSWORD@db:5432/content_gen_platform
#             (@db: 是 docker-compose 服务名，物理机部署时必须改为 localhost)
DATABASE_URL=postgresql://postgres:change-me-strong-password@localhost:5432/content_gen_platform

# ── Redis 配置 ─────────────────────────────────────────────────────────────────

# Redis 连接 URL:
#   [物理机] REDIS_URL=redis://localhost:6379/0
#   [Docker]  REDIS_URL=redis://redis:6379/0
#             (redis: 是 docker-compose 服务名，物理机部署时必须改为 localhost)
REDIS_URL=redis://localhost:6379/0

# ── CORS / 域名配置 ────────────────────────────────────────────────────────────

# 允许的主机名（逗号分隔，生产环境填写真实域名）
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# 允许的 CORS 来源（生产环境填写前端域名，格式: https://your-domain.com）
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ── 文件存储后端 ───────────────────────────────────────────────────────────────

# 存储后端: local（默认）或 minio
STORAGE_BACKEND=local

# 物理机本地存储路径（local 模式）:
#   [物理机] MEDIA_ROOT=/opt/genplatform/media
#   [Docker]  在容器内由 MEDIA_ROOT 环境变量或 settings.py 控制
MEDIA_ROOT=/opt/genplatform/media

# MinIO 配置（STORAGE_BACKEND=minio 时填写）:
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=content-gen

# ── AI 模型配置 ────────────────────────────────────────────────────────────────

# 嵌入模型名称（与 Docker 部署保持一致）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# HuggingFace 镜像地址（GFW 内服务器使用，可选）:
#   [物理机] HF_ENDPOINT=https://hf-mirror.com
#   [Docker]  HF_ENDPOINT 在 systemd 服务文件中单独配置，此处也可设置
HF_ENDPOINT=https://hf-mirror.com

# HuggingFace 模型缓存目录:
#   [物理机] 必须指向 genplatform 用户可写路径。默认 ~/.cache/huggingface 在
#           生产环境会落到 /home/genplatform/.cache/，但该用户用 --no-create-home
#           创建，目录不存在且不可由非 root 创建，会触发 PermissionError 让 KB 任务失败。
#           systemd 服务文件中已通过 Environment=HF_HOME=... 强制设置；此处仅作文档说明。
#   [Docker]  容器内通常用 /home/app/.cache，无此问题。
# HF_HOME=/opt/genplatform/.cache/huggingface

# ── LLM 网关配置（可选，根据实际 AI 提供商填写）──────────────────────────────

# LLM API 基础 URL（示例）
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-change-me

# ── 物理机部署专用配置 ─────────────────────────────────────────────────────────

# 应用部署根目录
#   [物理机] APP_DIR=/opt/genplatform
#   [Docker]  此变量不适用
APP_DIR=/opt/genplatform

# 代码分支（物理机部署时使用）
BRANCH=main

# ── Docker 部署专用配置 ────────────────────────────────────────────────────────
# 以下变量仅在 Docker 部署（make deploy-docker）时生效

# 后端镜像 tag（留空使用 docker-compose.yml 中的默认值）
# BACKEND_IMAGE_TAG=latest
# FRONTEND_IMAGE_TAG=latest

# ── 可选：Celery 并发配置 ──────────────────────────────────────────────────────

# Celery Worker 并发数（物理机默认 2，Docker 默认由 docker-compose.yml 控制）
# CELERY_WORKER_CONCURRENCY=2
