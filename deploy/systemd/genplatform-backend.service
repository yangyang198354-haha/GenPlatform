[Unit]
Description=GenPlatform Django ASGI Backend (Gunicorn + Uvicorn)
Documentation=https://github.com/yangyang198354-haha/GenPlatform
After=network.target postgresql.service postgresql-15.service redis.service redis-server.service
Wants=postgresql.service postgresql-15.service redis.service redis-server.service

[Service]
Type=notify
User=genplatform
Group=genplatform
WorkingDirectory=/opt/genplatform/app/project_workspace/content_gen_platform/src/backend
EnvironmentFile=/opt/genplatform/.env

# HF_HOME 显式指向部署用户可写的路径，避免 sentence_transformers 默认走
# $HOME/.cache/huggingface/ → /home/genplatform/.cache/... 触发 PermissionError
# （genplatform 用户用 --no-create-home 创建，/home/genplatform 不存在且不可创建）。
# 后端在 apps.knowledge_base.apps.ready() 启动时预热模型 + /search 也会用，
# 必须与 celery worker 用同一份 cache 才能复用已下载的模型。
Environment=HF_HOME=/opt/genplatform/.cache/huggingface

# 使用 Gunicorn 的 UvicornWorker 支持 ASGI（Django Channels / SSE）
# workers=2: 内存有限的服务器（4G）实测 4 workers 全部 OOM Killed
# max-requests + jitter: 每个 worker 处理一定请求后自动重启，释放可能泄漏的内存
ExecStart=/opt/genplatform/venv/bin/gunicorn \
    config.asgi:application \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 2 \
    --bind 0.0.0.0:8000 \
    --timeout 120 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --log-file /opt/genplatform/logs/gunicorn.log \
    --access-logfile /opt/genplatform/logs/gunicorn-access.log \
    --error-logfile /opt/genplatform/logs/gunicorn-error.log

# HUP 信号触发 Gunicorn graceful reload（零停机热更新）
ExecReload=/bin/kill -s HUP $MAINPID

# mixed 模式: SIGTERM 发送给主进程，子进程收到 SIGKILL
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=always
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60

# OOM 保护：低优先级被 OOM Killer 选中（与 celery 一致）
OOMScoreAdjust=-500

# 安全加固
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/genplatform/logs /opt/genplatform/media /opt/genplatform/staticfiles /opt/genplatform/.cache

[Install]
WantedBy=multi-user.target
