[Unit]
Description=GenPlatform Django ASGI Backend (Gunicorn + Uvicorn)
Documentation=https://github.com/yangyang198354-haha/GenPlatform
After=network.target postgresql.service postgresql-15.service redis.service redis-server.service
Wants=postgresql.service postgresql-15.service redis.service redis-server.service

[Service]
Type=notify
User=genplatform
Group=genplatform
WorkingDirectory=/opt/genplatform/app/project_workspace/content_gen_platform/src/backend
EnvironmentFile=/opt/genplatform/.env

# 使用 Gunicorn 的 UvicornWorker 支持 ASGI（Django Channels / SSE）
ExecStart=/opt/genplatform/venv/bin/gunicorn \
    config.asgi:application \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 4 \
    --bind 0.0.0.0:8000 \
    --timeout 120 \
    --log-file /opt/genplatform/logs/gunicorn.log \
    --access-logfile /opt/genplatform/logs/gunicorn-access.log \
    --error-logfile /opt/genplatform/logs/gunicorn-error.log

# HUP 信号触发 Gunicorn graceful reload（零停机热更新）
ExecReload=/bin/kill -s HUP $MAINPID

# mixed 模式: SIGTERM 发送给主进程，子进程收到 SIGKILL
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=always
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60

# 安全加固
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/genplatform/logs /opt/genplatform/media /opt/genplatform/staticfiles

[Install]
WantedBy=multi-user.target
